{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "atora-lms/section-curriculum",
  "version": "1.0.0",
  "title": "ATORA Premium: Contenido",
  "category": "atora-lms",
  "icon": "list-view",
  "description": "Temario del curso con lista de lecciones. Respeta los límites de vista previa configurados en el schema.",
  "keywords": ["curriculum", "temario", "lecciones", "contenido", "atora"],
  "textdomain": "atora-lms",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Contenido"
    },
    "title": {
      "type": "string",
      "default": "Temario claro, ritmo nítido, estructura premium."
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "items": {
      "type": "array",
      "default": [
        { "title": "Módulo 1", "text": "Introducción y base conceptual." },
        { "title": "Módulo 2", "text": "Aplicación práctica y seguimiento." }
      ]
    }
  },
  "usesContext": ["postId", "postType"],
  "supports": {
    "html": false,
    "inserter": false,
    "multiple": false,
    "reusable": false,
    "lock": false
  }
}

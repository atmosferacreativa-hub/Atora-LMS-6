{
    "name": "atora/atora-lms-runtime",
    "description": "Dependencias de ejecución empaquetadas con el plugin (PDF y QR de certificados).",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "vendor-dir": "packages",
        "platform-check": false
    }
}
